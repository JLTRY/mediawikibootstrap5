<head>
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
</head>
<body class="site">
	<div class="container mw-body">
		<nav class="mobile-only row" aria-label="Toggle navigation">
			<div class="col-lg-9 col-9">
				<button class="navbar-toggler ml-auto collapsed" id="btn-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<i class="fa-solid fa-bars"></i>
				</button>
			</div>
			<div class="col-lg-3 col-3">
				{{{html-mobile-connexion}}}
			</div>
		</nav>
		<div class="header">
			<div class="header-inner row">
				<div class="col-lg-9">
					<a href="{{link-mainpage}}">
						{{#data-logos}}
							{{^wordmark}}<img src="{{1x}}" width="{{width}}" height="{{height}}">{{/wordmark}}
						{{/data-logos}}
					</a>
				</div>
				<div class="col-lg-3 row">
					<div class="col-lg-12 col-6 pc-only">
						{{^is-registered}}<br/>{{{html-connexion}}}{{/is-registered}}
					</div>
					<div class="col-lg-12 col-6 pc-only"><br/>
						{{#data-search-box}}
						<div role="search" class="portlet" id="p-search">
							<div class="pBody" id="searchBody">
								<form action="{{form-action}}" id="searchform"><input type="hidden" name="title">{{{html-input}}}{{{html-button-search-fallback}}}</form>
							</div>
						</div>
						{{/data-search-box}}
					</div>
				</div>
			</div>
		</div>
		<nav class="navbar navbar-expand-lg" style="position:relative">
			<div class="offcanvas offcanvas-start" tabindex="-1" id="navbarSupportedContent" aria-labelledby="mobileMenuLogo">
				<div class="offcanvas-header">
					<button type="button" class="btn-close ms-auto" data-bs-dismiss="offcanvas" aria-label="Close"></button>
				</div>
				<div class="offcanvas-body">
					<div class="mobile-menu-brand">
						<a class="mobile-menu-logo" href="{{link-mainpage}}" aria-label="Main page">
							{{#data-logos}}
								{{^wordmark}}<img src="{{1x}}" width="{{width}}" height="{{height}}" alt="">{{/wordmark}}
							{{/data-logos}}
						</a>
					</div>
					<div class="mobile-only"><br/>
						{{#data-search-box}}
						<div role="search" class="portlet" id="p-search">
							<div class="pBody" id="searchBody">
								<form action="{{form-action}}" id="searchform"><input type="hidden" name="title">{{{html-input}}}{{{html-button-search-fallback}}}</form>
							</div>
							<hr>
						</div>
						{{/data-search-box}}
					</div>
					<ul class="menu navbar-nav me-auto">
						{{>NavBar}}
						{{#is-registered}}
						{{>PersonalUrls}}
						{{>ContentActions}}
						{{>ToolBox}}
						{{/is-registered}}
					</ul>
				</div>
			</div>
		</nav>
		<div class="container">
			<h1 class="firstHeading">{{{html-title}}}</h1>
			{{{html-output}}}
			{{{html-categories}}}
		</div>
		<div class="footer" style="height:60px;">
			<hr>
			{{#data-footer}}<p style="float: left;">{{!}}{{#data-icons}}{{>FooterList}}{{/data-icons}}{{/data-footer}}{{>FooterTexts}}</p>{{>FooterBarLinks}}
		</div><!--footer -->
	</div><!--container -->
</body>
</html>
