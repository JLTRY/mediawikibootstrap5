{{#data-navbar}}
{{#parent}}
<li class="dropdown nav-item">
	<a href="{{link}}" class="nav-link dropdown-toggle {{class}}" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
		{{title}}
	</a>
	<ul class="dropdown-menu" aria-labelledby="navbarDropdown">
{{/parent}}
{{^parent}}
<li class="nav-item">
	<a href="{{link}}" class="nav-link">
		{{title}}
	</a>
{{/parent}}
{{#sublinks}}
	<li class="nav-item">
		<a class="dropdown-item nav-link" href="{{link}}">
			{{title}}
		</a>
	</li>
{{/sublinks}}
{{#sublinks.length}}
	</ul>
{{/sublinks.length}}
</li>
{{/data-navbar}}
